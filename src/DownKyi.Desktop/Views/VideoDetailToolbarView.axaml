<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:DownKyi.ViewModels"
    xmlns:custom="clr-namespace:DownKyi.CustomControl"
    x:Class="DownKyi.Views.VideoDetailToolbarView"
    x:DataType="vm:ViewVideoDetailViewModel"
    Classes="studio-page">
    <UserControl.Styles>
        <StyleInclude Source="/Themes/Styles/Studio.axaml" />
    </UserControl.Styles>
    <Grid ColumnDefinitions="Auto,20,*,Auto,12,Auto" MinHeight="44">
        <Button
            Name="DetailBackButton"
            Classes="studio-back"
            Theme="{StaticResource PersonalNavigationButton}"
            Command="{Binding BackSpaceCommand}"
            Padding="8"
            VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Path
                    Width="24"
                    Height="24"
                    Theme="{StaticResource NavigationIcon.ArrowBack}"
                    Fill="{DynamicResource SpaceInk}"
                    VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource VideoDetailHeading}" FontSize="24" FontWeight="Bold" />
            </StackPanel>
        </Button>
        <Border Grid.Column="2" VerticalAlignment="Center">
            <TextBox
                Name="DetailInput"
                Height="40"
                Padding="12,0,36,0"
                VerticalContentAlignment="Center"
                Text="{Binding UiState.InputText,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}">
                <TextBox.Resources>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">
                        1
                    </Thickness>
                </TextBox.Resources>
                <TextBox.KeyBindings>
                    <KeyBinding Command="{Binding InputCommand}" Gesture="Enter" />
                </TextBox.KeyBindings>
            </TextBox>
        </Border>
        <custom:Loading
            Grid.Column="2"
            Width="20"
            Height="20"
            Margin="10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Foreground="{DynamicResource SpaceAccent}"
            IsActive="True"
            IsVisible="{Binding UiState.IsBusy}" />
        <Button
            Name="DetailParseButton"
            Grid.Column="3"
            Height="40"
            Classes="studio-primary"
            Command="{Binding InputCommand}"
            Content="{DynamicResource IndexParse}"
            VerticalAlignment="Center" />
        <Button
            Name="DetailDownloadsButton"
            Grid.Column="5"
            Height="40"
            Classes="studio-back"
            Theme="{StaticResource PersonalNavigationButton}"
            Padding="12,8"
            VerticalAlignment="Center"
            AutomationProperties.Name="{DynamicResource DownloadManager}"
            ToolTip.Tip="{DynamicResource DownloadManager}"
            Command="{Binding DownloadManagerCommand}">
            <Path
                Width="{Binding UiState.DownloadManage.Width}"
                Height="{Binding UiState.DownloadManage.Height}"
                Data="{Binding UiState.DownloadManage.Data}"
                Fill="{DynamicResource SpaceInk}"
                Stretch="Uniform" />
        </Button>
    </Grid>
</UserControl>
