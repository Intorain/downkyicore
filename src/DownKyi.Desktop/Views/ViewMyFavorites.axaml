<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:custom="clr-namespace:DownKyi.CustomControl"
    xmlns:vm="clr-namespace:DownKyi.ViewModels"
    xmlns:vmp="clr-namespace:DownKyi.Presentation"
    xmlns:asyncImageLoader="clr-namespace:DownKyi.CustomControl.AsyncImageLoader"
    x:Class="DownKyi.Views.ViewMyFavorites"
    Background="{DynamicResource SpacePaper}"
    mc:Ignorable="d"
    d:DesignWidth="840"
    d:DesignHeight="620"
    x:DataType="vm:ViewMyFavoritesViewModel">
    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <ControlTheme
            x:Key="MediaListStyle"
            TargetType="{x:Type ListBoxItem}"
            BasedOn="{StaticResource PersonalCollectionItem}"
            x:DataType="vmp:FavoritesMedia">
            <Setter Property="IsSelected" Value="{Binding IsSelected}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border Name="ItemSurface" Margin="0,0,12,12" BorderThickness="0,0,0,1" CornerRadius="0">
                            <Grid Name="NameMediaPanel" Width="190" Margin="8" RowDefinitions="115,*,*">
                                <Border Name="NameCover" Grid.Row="0" Width="185" Height="115" HorizontalAlignment="Center" CornerRadius="0">
                                    <Border.Background>
                                        <!--  长宽比：1.6  -->
                                        <ImageBrush
                                            asyncImageLoader:ImageBrushLoader.Source="{Binding Cover}"
                                            asyncImageLoader:ImageBrushLoader.Width="185"
                                            asyncImageLoader:ImageBrushLoader.Height="115" />
                                    </Border.Background>
                                    <ToolTip.Tip>
                                        <StackPanel>
                                            <StackPanel Height="20" Orientation="Horizontal">
                                                <TextBlock FontSize="12" Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource FavoritesPlayNumber}" />
                                                <TextBlock FontSize="12" Foreground="{DynamicResource SpaceInk}" Text="{Binding PlayNumber}" />
                                            </StackPanel>
                                            <StackPanel Height="20" Orientation="Horizontal">
                                                <TextBlock FontSize="12" Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource FavoritesFavoriteNumber}" />
                                                <TextBlock FontSize="12" Foreground="{DynamicResource SpaceInk}" Text="{Binding FavoriteNumber}" />
                                            </StackPanel>
                                            <StackPanel Height="20" Orientation="Horizontal">
                                                <TextBlock FontSize="12" Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource FavoritesUpName}" />
                                                <TextBlock FontSize="12" Foreground="{DynamicResource SpaceInk}" Text="{Binding UpName}" />
                                            </StackPanel>
                                            <StackPanel Height="20" Orientation="Horizontal">
                                                <TextBlock FontSize="12" Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource FavoritesCreateTime}" />
                                                <TextBlock FontSize="12" Foreground="{DynamicResource SpaceInk}" Text="{Binding CreateTime}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ToolTip.Tip>
                                    <Border Name="MediaDurationBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="4" Padding="5,2" Background="{DynamicResource SpaceCarbon}" IsHitTestVisible="False">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource SpaceCream}" Text="{Binding Duration}" />
                                    </Border>
                                </Border>
                                <ContentControl
                                    Name="NameChecked"
                                    Grid.Row="0"
                                    Width="24"
                                    Height="24"
                                    Margin="0,10,10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Theme="{StaticResource PersonalSelectionMark}" />
                                <Button Name="MediaTitleLink" Theme="{StaticResource PersonalMediaLink}" Command="{Binding TitleCommand}" AutomationProperties.Name="{Binding Title}" Grid.Row="1" Width="185" Height="48" Margin="0,5" IsEnabled="{Binding !IsUnavailable}">
                                    <TextBlock
                                        Name="NameTitle"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Classes.unavailable="{Binding IsUnavailable}"
                                        Cursor="Hand"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="WrapWithOverflow"
                                        ToolTip.Tip="{Binding Title}">
                                    </TextBlock>
                                </Button>
                                <Grid Grid.Row="2" ColumnDefinitions="120,*">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource SpaceMuted}" Text="{DynamicResource FavoritesFavTime}" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource SpaceMuted}" Text="{Binding FavTime}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style Selector="^ /template/ ContentControl#NameChecked">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^:selected /template/ ContentControl#NameChecked">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^ /template/ TextBlock#NameTitle:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource SpaceAccent}" />
            </Style>
            <Style Selector="^ /template/ TextBlock#NameTitle.unavailable">
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Foreground" Value="Red" />
                <Setter Property="TextDecorations" Value="Strikethrough" />
            </Style>
            <Style Selector="^ /template/ TextBlock#NameTitle.unavailable:pointerover">
                <Setter Property="Foreground" Value="Red" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,20,*" Margin="24,18,24,20" Background="{DynamicResource SpacePaper}">
        <Grid
            Grid.Row="0"
            Name="PersonalPageHeader"
            ColumnDefinitions="Auto,*,Auto"
            MinHeight="124"
            Background="{DynamicResource SpaceAccent}">
            <ContentControl
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Width="240"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Theme="{StaticResource PersonalHeaderArtwork}" />
            <Button
                Grid.Column="0"
                Margin="12,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding BackSpaceCommand}"
                Theme="{StaticResource PersonalPosterNavigationButton}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ContentControl Width="24" Height="24">
                        <Path
                            Width="{Binding ArrowBack.Width}"
                            Height="{Binding ArrowBack.Height}"
                            Data="{Binding ArrowBack.Data}"
                            Fill="{DynamicResource SpaceCarbon}"
                            Stretch="None" />
                    </ContentControl>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="48"
                        FontWeight="Black"
                        Foreground="{DynamicResource SpaceCarbon}"
                        Text="{DynamicResource Favorites}" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                Width="44"
                Height="44"
                Padding="10"
                Margin="12,0,20,0"
                Background="{DynamicResource SpaceCream}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Command="{Binding DownloadManagerCommand}"
                Theme="{StaticResource PersonalPosterNavigationButton}"
                ToolTip.Tip="{DynamicResource DownloadManager}">
                <ContentControl Width="24" Height="24">
                    <Path
                        Width="{Binding DownloadManage.Width}"
                        Height="{Binding DownloadManage.Height}"
                        Data="{Binding DownloadManage.Data}"
                        Fill="{DynamicResource SpaceCarbon}"
                        Stretch="Uniform" />
                </ContentControl>
            </Button>
        </Grid>
        <Grid Grid.Row="2" IsVisible="{Binding ContentVisibility}" ColumnDefinitions="192,*">
            <!--  左侧tab header  -->
            <ListBox
                Name="NameLeftTabHeaders"
                Background="Transparent"
                Grid.Column="0"
                BorderThickness="0"
                IsEnabled="{Binding IsEnabled}"
                ItemsSource="{Binding TabHeaders}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                ItemContainerTheme="{StaticResource PersonalSidebarItem}"
                Theme="{StaticResource PersonalSidebar}"
                SelectedIndex="{Binding SelectTabId, Mode=TwoWay}">
                <Interaction.Behaviors>
                    <EventTriggerBehavior EventName="SelectionChanged">
                        <InvokeCommandAction
                            Command="{Binding LeftTabHeadersCommand}"
                            CommandParameter="{Binding ElementName=NameLeftTabHeaders, Path=SelectedItem}" />
                    </EventTriggerBehavior>
                </Interaction.Behaviors>
            </ListBox>
            <Grid Name="NameMediaPanel" Grid.Column="1" IsVisible="{Binding MediaContentVisibility}" RowDefinitions="Auto,*,1,Auto">
                <Grid Grid.Row="0" Margin="8,0,12,16" ColumnDefinitions="*,80">
                    <TextBox
                        Grid.Column="0"
                        IsEnabled="{Binding IsEnabled}"
                        PlaceholderText="{DynamicResource SearchVideoByName}"
                        Text="{Binding InputSearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                        <TextBox.KeyBindings>
                            <KeyBinding Command="{Binding SearchCommand}" Gesture="Enter" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Command="{Binding SearchCommand}"
                        Content="{DynamicResource Search}"
                        Theme="{StaticResource PersonalActionButton}" />
                </Grid>
                <ListBox
                    x:Name="NameMedias"
                    Grid.Row="1"
                    BorderThickness="0"
                    ItemsSource="{Binding Medias}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionMode="Multiple,Toggle"
                    ItemContainerTheme="{StaticResource MediaListStyle}">
                    <Interaction.Behaviors>
                        <EventTriggerBehavior EventName="SelectionChanged">
                            <InvokeCommandAction Command="{Binding MediasCommand}" CommandParameter="{Binding ElementName=NameMedias, Path=SelectedItems}" />
                        </EventTriggerBehavior>
                    </Interaction.Behaviors>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Theme>
                        <ControlTheme TargetType="ListBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBox">
                                        <Border
                                            x:Name="Bd"
                                            Padding="0"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <ScrollViewer Focusable="False">
                                                <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                            </ScrollViewer>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </ControlTheme>
                    </ListBox.Theme>
                </ListBox>
                <TextBlock Grid.Row="2" Background="{DynamicResource SpaceRule}" />
                <Grid Grid.Row="3" Name="PersonalLibraryToolbar" RowDefinitions="Auto,48" ColumnDefinitions="Auto,*,Auto,Auto">
                    <CheckBox
                        Theme="{StaticResource PersonalCheckBox}"
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{Binding SelectAllCommand}"
                        Content="{DynamicResource SelectAll}"
                        Foreground="{DynamicResource SpaceInk}"
                        IsChecked="{Binding IsSelectAll, Mode=TwoWay}" />
                    <Grid
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding !DownloadCommandGate.IsExecuting}">
                        <custom:CustomPager Classes="personal" Margin="0,8" DataContext="{Binding Pager}" />
                    </Grid>
                    <custom:DownloadPreparationStatus
                        x:Name="DownloadPreparationStatus"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        CancelCommand="{Binding CancelDownloadPreparationCommand}"
                        IsActive="{Binding DownloadCommandGate.IsExecuting}" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding AddToDownloadCommand}"
                        Content="{DynamicResource DownloadSelectedPublication}"
                        FontSize="12"
                        Theme="{StaticResource PersonalActionButton}" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="3"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Classes="secondary"
                        Command="{Binding AddAllToDownloadCommand}"
                        Content="{DynamicResource DownloadAllPublication}"
                        FontSize="12"
                        Theme="{StaticResource PersonalActionButton}" />
                </Grid>
            </Grid>
            <!--  加载gif  -->
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical"
                IsVisible="{Binding MediaLoadingVisibility}">
                <custom:Loading Width="40" Height="40" Foreground="{DynamicResource SpaceAccent}" IsActive="{Binding MediaLoading}" />
            </StackPanel>
            <!--  没有数据提示  -->
            <ContentControl Theme="{StaticResource StudioEmptyState}" Grid.Column="1" IsVisible="{Binding MediaNoDataVisibility}" />
        </Grid>
        <!--  加载gif  -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical"
            IsVisible="{Binding LoadingVisibility}">
            <custom:Loading Width="40" Height="40" Foreground="{DynamicResource SpaceAccent}" IsActive="{Binding Loading}" />
            <TextBlock Margin="0,10,0,0" FontSize="14" Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource PublicationWait}" />
        </StackPanel>
        <!--  没有数据提示  -->
        <ContentControl Theme="{StaticResource StudioEmptyState}" Grid.Row="2" IsVisible="{Binding NoDataVisibility}" />
    </Grid>
</UserControl>
