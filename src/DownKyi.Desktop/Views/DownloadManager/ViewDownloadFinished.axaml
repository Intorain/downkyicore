<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DownKyi.Views.DownloadManager.ViewDownloadFinished"
             xmlns:images="clr-namespace:DownKyi.Images"
             xmlns:vmdm="clr-namespace:DownKyi.ViewModels.DownloadManager"
             x:DataType="vmdm:ViewDownloadFinishedViewModel"
             Background="{DynamicResource SpacePaper}">
    <UserControl.Styles>
        <Style Selector="ComboBox#NameFinishedSort">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SpacePaper}" />
            <Setter Property="Foreground" Value="{DynamicResource SpaceInk}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SpaceRule}" />
        </Style>
        <Style Selector="ComboBox#NameFinishedSort:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource SpaceInk}" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <ControlTheme x:Key="DownloadedStyle" TargetType="{x:Type ListBoxItem}" x:DataType="vmdm:DownloadedItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border
                            Name="NameFinishedTaskRow"
                            Height="86"
                            Padding="14,0"
                            BorderBrush="{DynamicResource SpaceRule}" BorderThickness="0,0,0,1"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0">
                            <Grid ColumnDefinitions="52,*,160,136">

                                <Border
                                    Name="NameFinishedZoneIconFrame"
                                    Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SpaceHover}"
                                    CornerRadius="0">
                                    <Image
                                        Width="32"
                                        Height="32"
                                        Source="{Binding ZoneImage}" />
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    Spacing="6">

                                    <TextBlock
                                        Name="NameFinishedTaskTitle"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource SpaceInk}"
                                        TextTrimming="CharacterEllipsis">
                                        <ToolTip.Tip>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}-{1}">
                                                        <Binding Path="MainTitle" />
                                                        <Binding Path="Name" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </ToolTip.Tip>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}-{1}-{2}">
                                                <Binding Path="Order" />
                                                <Binding Path="MainTitle" />
                                                <Binding Path="Name" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <TextBlock
                                        Name="NameFinishedTaskMetadata"
                                        FontSize="12"
                                        Foreground="{DynamicResource SpaceMuted}"
                                        TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1} · {2} · {3} · {4}">
                                                <Binding Path="Duration" />
                                                <Binding Path="Resolution.Name" />
                                                <Binding Path="VideoCodecName" />
                                                <Binding Path="AudioCodec.Name" />
                                                <Binding Path="FileSize" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock
                                    Name="NameFinishedTime"
                                            FontFamily="Cascadia Mono,Consolas,monospace"
                                    Grid.Column="2"
                                    Width="144"
                                    Margin="0,0,12,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource SpaceMuted}"
                                    Text="{Binding FinishedTime}" />

                                <StackPanel
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">

                                    <Button
                                        Name="NameFinishedOpenFolderButton"
                                        Width="36"
                                        Height="36"
                                        MinWidth="36"
                                        MinHeight="36"
                                        Padding="0"
                                        Command="{Binding ElementName=DownloadedList,Path=((vmdm:ViewDownloadFinishedViewModel)DataContext).OpenFolderCommand}"
                                        CommandParameter="{Binding}"
                                        Theme="{StaticResource DownloadActionButton}"
                                        ToolTip.Tip="{DynamicResource OpenFolder}">
                                        <ContentControl Width="18" Height="18">
                                            <Path
                                                Width="{Binding OpenFolder.Width}"
                                                Height="{Binding OpenFolder.Height}"
                                                Data="{Binding OpenFolder.Data}"
                                                Fill="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                                Stretch="Uniform" />
                                        </ContentControl>
                                    </Button>

                                    <Button
                                        Name="NameFinishedOpenVideoButton"
                                        Width="36"
                                        Height="36"
                                        MinWidth="36"
                                        MinHeight="36"
                                        Padding="0"
                                        Command="{Binding ElementName=DownloadedList,Path=((vmdm:ViewDownloadFinishedViewModel)DataContext).OpenVideoCommand}"
                                        CommandParameter="{Binding}"
                                        Theme="{StaticResource DownloadActionButton}"
                                        ToolTip.Tip="{DynamicResource OpenVideo}">
                                        <ContentControl Width="18" Height="18">
                                            <Path
                                                Width="{Binding OpenVideo.Width}"
                                                Height="{Binding OpenVideo.Height}"
                                                Data="{Binding OpenVideo.Data}"
                                                Fill="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                                Stretch="Uniform" />
                                        </ContentControl>
                                    </Button>

                                    <Button
                                        Name="NameFinishedRemoveButton"
                                        Width="36"
                                        Height="36"
                                        MinWidth="36"
                                        MinHeight="36"
                                        Padding="0"
                                        Command="{Binding ElementName=DownloadedList,Path=((vmdm:ViewDownloadFinishedViewModel)DataContext).RemoveVideoCommand}"
                                        CommandParameter="{Binding}"
                                        Classes="danger"
                                        Foreground="{DynamicResource DownloadWarning}"
                                        Theme="{StaticResource DownloadActionButton}"
                                        ToolTip.Tip="{DynamicResource DeleteDownload}">
                                        <ContentControl Width="18" Height="18">
                                            <Path
                                                Width="{Binding RemoveVideo.Width}"
                                                Height="{Binding RemoveVideo.Height}"
                                                Data="{Binding RemoveVideo.Data}"
                                                Fill="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                                Stretch="Uniform" />
                                        </ContentControl>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource SpaceHover}" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>
    <Grid>
        <Grid
            Name="NameDownloadedContent"
            Height="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Path=Bounds.Height}"
            RowDefinitions="32,*,1,58"
            IsVisible="{Binding DownloadedList.Count}">

            <Grid Name="DownloadColumnHeader" Margin="14,0,26,0" ColumnDefinitions="52,*,160,136">
                <TextBlock Grid.Column="1" Text="{DynamicResource DownloadTaskColumn}" FontSize="12"
                           Foreground="{DynamicResource SpaceMuted}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{DynamicResource DownloadCompletedColumn}" FontSize="12"
                           Foreground="{DynamicResource SpaceMuted}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{DynamicResource DownloadActionsColumn}" FontSize="12"
                           Foreground="{DynamicResource SpaceMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <ListBox
                Name="DownloadedList"
                Grid.Row="1"
                Margin="0,0,12,0"
                BorderThickness="0"
                ItemContainerTheme="{StaticResource DownloadedStyle}"
                ItemsSource="{Binding DownloadedList}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Theme>
                    <ControlTheme TargetType="ListBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBox">
                                    <Border
                                        x:Name="Bd"
                                        Padding="0"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                        <ScrollViewer
                                            Focusable="False"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                            Width="{TemplateBinding Width}"
                                                            Height="{TemplateBinding Height}" />
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </ControlTheme>
                </ListBox.Theme>
            </ListBox>

            <TextBlock Grid.Row="2" Background="{DynamicResource SpaceRule}" />

            <Border
                Name="NameFinishedActionBar"
                Grid.Row="3"
                Padding="16,0"
                Background="{DynamicResource SpacePaper}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel
                        Name="NameFinishedSummary"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{DynamicResource SpaceInk}"
                            Text="{DynamicResource DownloadCompletedLabel}" />
                        <TextBlock
                            Name="NameDownloadedCount"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            FontSize="22" FontFamily="Cascadia Mono,Consolas,monospace"
                            FontWeight="Bold"
                            Foreground="{DynamicResource SpaceInk}"
                            Text="{Binding DownloadedList.Count}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{DynamicResource SpaceInk}"
                            Text="{DynamicResource DownloadTaskUnit}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <ComboBox
                            Name="NameFinishedSort"
                            MinWidth="120"
                            VerticalAlignment="Center"
                            SelectedIndex="{Binding FinishedSortBy}">
                            <Interaction.Behaviors>
                                <EventTriggerBehavior EventName="SelectionChanged">
                                    <InvokeCommandAction Command="{Binding FinishedSortCommand}"
                                                         CommandParameter="{Binding ElementName=NameFinishedSort, Path=SelectedIndex}" />
                                </EventTriggerBehavior>
                            </Interaction.Behaviors>
                            <ComboBoxItem Content="{DynamicResource DownloadedSortByTimeAsc}" />
                            <ComboBoxItem Content="{DynamicResource DownloadedSortByTimeDesc}" />
                            <ComboBoxItem Content="{DynamicResource DownloadedSortByOrder}" />
                        </ComboBox>

                        <Border
                            Name="NameFinishedClearDivider"
                            Width="1"
                            Height="24"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SpaceRule}" />

                        <Button
                            Name="NameClearAllDownloadedButton"
                            Classes="danger"
                            MinWidth="104"
                            Background="{DynamicResource SpacePaper}"
                            Command="{Binding ClearAllDownloadedCommand}"
                            FontSize="12"
                            Foreground="{DynamicResource DownloadWarning}"
                            Theme="{StaticResource DownloadActionButton}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path
                                    Width="16"
                                    Height="16"
                                    Data="{Binding Data, Source={x:Static images:ButtonIcon.Trash}}"
                                    Fill="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                    Stretch="Uniform" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource ClearAllDownloaded}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Name="DownloadEmptyState" MaxWidth="400" Margin="32" Spacing="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !DownloadedList.Count}">
            <Border Width="40" Height="4" HorizontalAlignment="Left" Background="{DynamicResource SpaceAccent}" />
            <TextBlock Text="{DynamicResource DownloadHistoryEmptyTitle}" FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource SpaceInk}" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource DownloadHistoryEmptyHint}" FontSize="14" LineHeight="24"
                       Foreground="{DynamicResource SpaceMuted}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
