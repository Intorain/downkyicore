<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DownKyi.Views.Dialogs.ViewDownloadSetter"
             xmlns:vmd="clr-namespace:DownKyi.ViewModels.Dialogs"
             x:DataType="vmd:ViewDownloadSetterViewModel">
    <Border BorderBrush="{DynamicResource BrushWindowBorder}" BorderThickness="1,1,1,0.6">
        <Grid RowDefinitions="40,*">

            <Grid
                Grid.Row="0"
                Background="{DynamicResource BrushBackgroundGreyTranslucent3}"
                WindowDecorationProperties.ElementRole="TitleBar"
                ColumnDefinitions="*,50,*,50">

                <TextBlock
                    Grid.Column="0"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource BrushCaptionForeground}"
                    Text="{Binding Title}" />

                <Button
                    Grid.Column="3"
                    Command="{Binding CloseCommand}"
                    WindowDecorationProperties.ElementRole="User"
                    Theme="{StaticResource ImageBtnStyle}">
                    <Path
                        Width="{Binding CloseIcon.Width}"
                        Height="{Binding CloseIcon.Height}"
                        Data="{Binding CloseIcon.Data}"
                        Fill="{DynamicResource BrushSystemBtnTintDark}"
                        Stretch="UniformToFill" />
                </Button>
            </Grid>
            <Grid
                Grid.Row="1"
                MinWidth="620"
                Margin="24,16,24,20"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                <Grid
                    x:Name="TransferIllustration"
                    Grid.Row="0"
                    Height="48"
                    Margin="72,0"
                    ColumnDefinitions="*,Auto,*">

                    <ContentControl
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Path
                            Width="{Binding CloudDownloadIcon.Width}"
                            Height="{Binding CloudDownloadIcon.Height}"
                            Data="{Binding CloudDownloadIcon.Data}"
                            Fill="{DynamicResource BrushPrimary}"
                            Stretch="UniformToFill" />
                    </ContentControl>

                    <TextBlock
                        Grid.Column="1"
                        Margin="36,0"
                        VerticalAlignment="Center"
                        FontSize="24"
                        Foreground="{DynamicResource BrushPrimary}"
                        Text="→" />

                    <ContentControl
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Path
                            Width="{Binding FolderIcon.Width}"
                            Height="{Binding FolderIcon.Height}"
                            Data="{Binding FolderIcon.Data}"
                            Fill="{DynamicResource BrushPrimary}"
                            Stretch="UniformToFill" />
                    </ContentControl>
                </Grid>

                <Grid
                    x:Name="DirectorySection"
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    RowDefinitions="Auto,Auto"
                    ColumnDefinitions="72,*,Auto">
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource BrushTextDark}"
                        Text="{DynamicResource Location}" />
                    <ComboBox
                        x:Name="DirectoryComboBox"
                        Grid.Row="0"
                        Grid.Column="1"
                        MinWidth="360"
                        Margin="12,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        ItemsSource="{Binding DirectoryList, Mode=TwoWay}"
                        SelectedValue="{Binding Directory, Mode=TwoWay}" />

                    <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding BrowseCommand}"
                        Content="{DynamicResource Browse}"
                        FontSize="12"
                        Theme="{StaticResource BtnStyle}" />

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="12,8,12,0"
                        Orientation="Horizontal">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource BrushTextDark}"
                            Text="{DynamicResource HardDiskFreeSpace}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource BrushTextDark}"
                            Text="{Binding DriveNameFreeSpace}" />
                    </StackPanel>
                </Grid>

                <Grid
                    x:Name="DownloadContentSection"
                    Grid.Row="2"
                    Margin="0,18,0,0"
                    ColumnDefinitions="72,*">

                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource BrushTextDark}"
                        Text="{DynamicResource DownloadContent}" />

                    <Grid
                        x:Name="DownloadContentOptions"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                        ColumnSpacing="20">
                        <CheckBox
                            Grid.Column="0"
                            Command="{Binding DownloadAllCommand}"
                            Content="{DynamicResource DownloadAll}"
                            Foreground="{DynamicResource BrushTextDark}"
                            IsChecked="{Binding DownloadAll, Mode=TwoWay}" />
                        <CheckBox
                            Grid.Column="1"
                            Command="{Binding DownloadAudioCommand}"
                            Content="{DynamicResource DownloadAudio}"
                            Foreground="{DynamicResource BrushTextDark}"
                            IsChecked="{Binding DownloadAudio, Mode=TwoWay}" />
                        <CheckBox
                            Grid.Column="2"
                            Command="{Binding DownloadVideoCommand}"
                            Content="{DynamicResource DownloadVideo}"
                            Foreground="{DynamicResource BrushTextDark}"
                            IsChecked="{Binding DownloadVideo, Mode=TwoWay}" />
                        <CheckBox
                            Grid.Column="3"
                            Command="{Binding DownloadDanmakuCommand}"
                            Content="{DynamicResource DownloadDanmaku}"
                            Foreground="{DynamicResource BrushTextDark}"
                            IsChecked="{Binding DownloadDanmaku, Mode=TwoWay}" />
                        <CheckBox
                            Grid.Column="4"
                            Command="{Binding DownloadCoverCommand}"
                            Content="{DynamicResource DownloadCover}"
                            Foreground="{DynamicResource BrushTextDark}"
                            IsChecked="{Binding DownloadCover, Mode=TwoWay}" />
                    </Grid>
                </Grid>

                <Grid
                    x:Name="SubtitleSection"
                    Grid.Row="3"
                    Margin="0,18,0,0"
                    ColumnDefinitions="72,*">
                    <TextBlock
                        x:Name="SubtitleSectionLabel"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource BrushTextDark}"
                        Text="{DynamicResource DownloadSubtitle}" />
                    <Border
                        x:Name="SubtitleTrackBorder"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Padding="12,4"
                        Background="{DynamicResource BrushSurfaceSunken}"
                        BorderBrush="{DynamicResource BrushControlStroke}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource DownKyiRadiusSmall}"
                        IsVisible="{Binding HasSubtitleTracks}">
                        <StackPanel Spacing="4">
                            <ScrollViewer MaxHeight="144" VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    x:Name="SubtitleTrackSelector"
                                    ItemsSource="{Binding SubtitleTracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vmd:SubtitleTrackItem">
                                            <Grid
                                                MinHeight="36"
                                                ColumnDefinitions="32,2*,*,48,Auto">
                                                <CheckBox
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding DisplayLanguage}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Language}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding !IsAi}"
                                                    Text="{DynamicResource SubtitleTypeStandard}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsAi}"
                                                    Text="{DynamicResource SubtitleTypeAi}" />
                                                <RadioButton
                                                    Grid.Column="4"
                                                    VerticalAlignment="Center"
                                                    Content="{DynamicResource DefaultSubtitle}"
                                                    GroupName="DefaultSubtitle"
                                                    IsChecked="{Binding IsDefault, Mode=TwoWay}"
                                                    IsEnabled="{Binding IsSelected}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock
                                x:Name="SubtitleTrackSelectionTip"
                                Margin="4,2,4,4"
                                FontSize="11"
                                Foreground="{DynamicResource BrushTextGrey}"
                                Text="{DynamicResource SubtitleTrackSelectionTip}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="SubtitleFallbackPanel"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Padding="12,10"
                        Background="{DynamicResource BrushSurfaceSunken}"
                        BorderBrush="{DynamicResource BrushControlStroke}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource DownKyiRadiusSmall}"
                        IsVisible="{Binding !HasSubtitleTracks}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,Auto,140,Auto,150">
                                <CheckBox
                                    VerticalAlignment="Center"
                                    Command="{Binding DownloadSubtitleCommand}"
                                    Content="{DynamicResource DownloadSubtitle}"
                                    IsChecked="{Binding DownloadSubtitle, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="16,0,8,0"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource PreferredSubtitleLanguage}" />
                                <ComboBox
                                    Grid.Column="2"
                                    DisplayMemberBinding="{Binding Name}"
                                    ItemsSource="{Binding SubtitleLanguagePreferences}"
                                    SelectedItem="{Binding SelectedSubtitleLanguagePreference}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Margin="16,0,8,0"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource PreferredSubtitleType}" />
                                <ComboBox
                                    Grid.Column="4"
                                    DisplayMemberBinding="{Binding Name}"
                                    ItemsSource="{Binding SubtitleTypePreferences}"
                                    SelectedItem="{Binding SelectedSubtitleTypePreference}" />
                            </Grid>
                            <TextBlock
                                Foreground="{DynamicResource BrushTextGrey}"
                                Text="{DynamicResource SubtitleFallbackTip}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel
                    Grid.Row="4"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        Width="84"
                        Command="{Binding DownloadCommand}"
                        Content="{DynamicResource Download}"
                        FontSize="12"
                        Theme="{StaticResource BtnStyle}" />
                    <Button
                        Width="84"
                        Command="{Binding CloseCommand}"
                        Content="{DynamicResource Cancel}"
                        FontSize="12"
                        Theme="{StaticResource BtnStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
