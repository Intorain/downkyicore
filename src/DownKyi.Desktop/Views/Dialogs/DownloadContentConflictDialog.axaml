<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vmd="clr-namespace:DownKyi.ViewModels.Dialogs"
    x:Class="DownKyi.Views.Dialogs.DownloadContentConflictDialog"
    x:DataType="vmd:DownloadContentConflictDialogViewModel"
    Classes="studio-page studio-dialog">
    <UserControl.Styles>
        <StyleInclude Source="/Themes/Styles/StudioDialog.axaml" />
    </UserControl.Styles>
    <Border Background="{DynamicResource SpacePaper}" BorderBrush="{DynamicResource SpaceRule}" BorderThickness="1">
        <Grid RowDefinitions="40,*,Auto">
            <Grid Classes="dialog-titlebar" ColumnDefinitions="*,40" WindowDecorationProperties.ElementRole="TitleBar">
                <TextBlock
                    Text="DownKyi"
                    FontSize="12"
                    Margin="24,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource SpaceMuted}" />
            </Grid>
            <ScrollViewer
                Name="DialogBodyScroll"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,16,24,24" Spacing="16">
                    <TextBlock Text="{Binding Title}" Classes="dialog-heading" />
                    <TextBlock
                        Foreground="{DynamicResource SpaceInk}"
                        FontSize="14"
                        Text="{Binding Message}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{DynamicResource SpaceInk}"
                        IsVisible="{Binding HasSingleQualitySubstitution}"
                        Text="{Binding QualitySubstitution}"
                        TextWrapping="Wrap" />
                    <Border
                        Padding="14,12"
                        Background="{DynamicResource SpaceHover}"
                        BorderBrush="{DynamicResource SpaceRule}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0"
                        IsVisible="{Binding IsQualitySubstitutionBatch}">
                        <ScrollViewer
                            x:Name="QualitySubstitutionGroupsScrollViewer"
                            MaxHeight="160"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="QualitySubstitutionGroupsList" ItemsSource="{Binding QualitySubstitutionGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="0,3"
                                            Foreground="{DynamicResource SpaceInk}"
                                            FontWeight="SemiBold"
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Expander
                        x:Name="AffectedQualityItemsExpander"
                        Header="{Binding AffectedItemsHeader}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsVisible="{Binding IsQualitySubstitutionBatch}">
                        <Border
                            Margin="0,8,0,0"
                            BorderBrush="{DynamicResource SpaceRule}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0">
                            <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="AffectedQualityItemsList" ItemsSource="{Binding QualitySubstitutionItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vmd:DownloadQualitySubstitutionItemViewModel">
                                            <Border Padding="12,10" BorderBrush="{DynamicResource SpaceRule}" BorderThickness="0,0,0,1">
                                                <StackPanel Spacing="4">
                                                    <TextBlock
                                                        Foreground="{DynamicResource SpaceInk}"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding PageName}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Foreground="{DynamicResource SpaceMuted}"
                                                        FontSize="12"
                                                        Text="{Binding Description}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Expander>
                    <TextBlock
                        Foreground="{DynamicResource SpaceMuted}"
                        FontSize="12"
                        IsVisible="{Binding IsQualitySubstitutionBatch}"
                        Text="{Binding SettingsHint}"
                        TextWrapping="Wrap" />
                    <CheckBox
                        Content="{Binding ApplyToAllText}"
                        Foreground="{DynamicResource SpaceInk}"
                        IsVisible="{Binding ShowApplyToAll}"
                        IsChecked="{Binding ApplyToAll, Mode=TwoWay}" />
                    <TextBlock
                        MaxWidth="560"
                        Foreground="{DynamicResource SpaceInk}"
                        IsVisible="{Binding HasSingleQualitySubstitution}"
                        Text="{DynamicResource ApplyToAllQualitySubstitutionExplanation}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
            <Border Name="DialogFooter" Classes="dialog-footer" Grid.Row="2">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Button
                        x:Name="UseAvailableContentButton"
                        Grid.Column="0"
                        Command="{Binding UseAvailableContentCommand}"
                        MinHeight="40"
                        Classes="studio-primary"
                        HorizontalContentAlignment="Center">
                        <TextBlock Text="{Binding UseAvailableContent}" TextAlignment="Center" TextWrapping="Wrap" />
                    </Button>
                    <Button
                        x:Name="SkipDownloadPageButton"
                        Grid.Column="1"
                        Command="{Binding SkipPageCommand}"
                        MinHeight="40"
                        HorizontalContentAlignment="Center">
                        <TextBlock Text="{Binding SkipPageText}" TextAlignment="Center" TextWrapping="Wrap" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
