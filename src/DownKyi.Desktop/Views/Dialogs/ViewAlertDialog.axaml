<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vmd="clr-namespace:DownKyi.ViewModels.Dialogs"
    x:Class="DownKyi.Views.Dialogs.ViewAlertDialog"
    x:DataType="vmd:ViewAlertDialogViewModel"
    Classes="studio-page studio-dialog">
    <UserControl.Styles>
        <StyleInclude Source="/Themes/Styles/StudioDialog.axaml" />
    </UserControl.Styles>
    <Border Background="{DynamicResource SpacePaper}" BorderBrush="{DynamicResource SpaceRule}" BorderThickness="1">
        <Grid RowDefinitions="40,*,Auto">
            <Grid Classes="dialog-titlebar" ColumnDefinitions="*,40" WindowDecorationProperties.ElementRole="TitleBar">
                <TextBlock
                    Text="DownKyi"
                    FontSize="12"
                    Margin="24,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource SpaceMuted}" />
                <Button
                    Grid.Column="1"
                    Classes="studio-back dialog-close"
                    Theme="{StaticResource PersonalNavigationButton}"
                    Command="{Binding CloseCommand}"
                    WindowDecorationProperties.ElementRole="User"
                    ToolTip.Tip="{DynamicResource Close}">
                    <Path
                        Width="16"
                        Height="16"
                        Data="{Binding CloseIcon.Data}"
                        Fill="{DynamicResource SpaceInk}"
                        Stretch="Uniform" />
                </Button>
            </Grid>
            <ScrollViewer
                Name="DialogBodyScroll"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,16,24,24" Spacing="16">
                    <TextBlock Text="{Binding Title}" Classes="dialog-heading" />
                    <Grid ColumnDefinitions="32,*">
                        <ContentControl IsVisible="{Binding Image,Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Top" Margin="0,2,12,0">
                            <Path
                                Width="20"
                                Height="20"
                                Data="{Binding Image.Data}"
                                Fill="{Binding Image.Fill}"
                                Stretch="Uniform" />
                        </ContentControl>
                        <TextBlock
                            Grid.Column="1"
                            FontSize="16"
                            Text="{Binding Message}"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <Border Name="DialogFooter" Classes="dialog-footer" Grid.Row="2">
                <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Name="AcceptAlertButton"
                        Classes="studio-primary"
                        MinWidth="104"
                        Margin="8,0,0,0"
                        Command="{Binding AllowCommand}"
                        Content="{DynamicResource Allow}"
                        IsVisible="{Binding AloneButton}" />
                    <Button
                        Name="ConfirmAlertButton"
                        Classes="studio-primary"
                        MinWidth="104"
                        Margin="8,0,0,0"
                        Command="{Binding AllowCommand}"
                        Content="{DynamicResource Allow}"
                        IsVisible="{Binding TwoButton}" />
                    <Button
                        Name="CancelAlertButton"
                        MinWidth="104"
                        Margin="12,0,0,0"
                        Command="{Binding CloseCommand}"
                        Content="{DynamicResource Cancel}"
                        IsVisible="{Binding TwoButton}" />
                </WrapPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
