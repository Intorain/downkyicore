<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vmd="clr-namespace:DownKyi.ViewModels.Dialogs"
    x:Class="DownKyi.Views.Dialogs.DownloadDuplicateBatchDialog"
    x:DataType="vmd:DownloadDuplicateBatchDialogViewModel"
    Classes="studio-page studio-dialog">
    <UserControl.Styles>
        <StyleInclude Source="/Themes/Styles/StudioDialog.axaml" />
    </UserControl.Styles>
    <Border Background="{DynamicResource SpacePaper}" BorderBrush="{DynamicResource SpaceRule}" BorderThickness="1">
        <Grid RowDefinitions="40,*,Auto">
            <Grid Classes="dialog-titlebar" ColumnDefinitions="*,40" WindowDecorationProperties.ElementRole="TitleBar">
                <TextBlock
                    Text="DownKyi"
                    FontSize="12"
                    Margin="24,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource SpaceMuted}" />
            </Grid>
            <ScrollViewer
                Name="DialogBodyScroll"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,16,24,24" Spacing="16">
                    <TextBlock Text="{Binding Title}" Classes="dialog-heading" />
                    <TextBlock
                        Foreground="{DynamicResource SpaceInk}"
                        FontSize="14"
                        Text="{Binding Message}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{DynamicResource SpaceMuted}"
                        FontSize="12"
                        IsVisible="{Binding HasActiveDuplicates}"
                        Text="{Binding ActiveDuplicateMessage}"
                        TextWrapping="Wrap" />
                    <Expander
                        x:Name="CompletedDuplicateItemsExpander"
                        Header="{Binding AffectedItemsHeader}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                        <Border
                            Margin="0,8,0,0"
                            BorderBrush="{DynamicResource SpaceRule}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0">
                            <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="CompletedDuplicateItemsList" ItemsSource="{Binding CompletedItemNames}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Padding="12,10"
                                                Foreground="{DynamicResource SpaceInk}"
                                                Text="{Binding}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <Border Name="DialogFooter" Classes="dialog-footer" Grid.Row="2">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Button
                        x:Name="RedownloadDuplicateBatchButton"
                        Grid.Column="0"
                        Command="{Binding RedownloadCommand}"
                        MinHeight="40"
                        Classes="studio-primary"
                        HorizontalContentAlignment="Center">
                        <TextBlock Text="{Binding RedownloadText}" TextAlignment="Center" TextWrapping="Wrap" />
                    </Button>
                    <Button
                        x:Name="SkipDuplicateBatchButton"
                        Grid.Column="1"
                        Command="{Binding SkipCommand}"
                        MinHeight="40"
                        HorizontalContentAlignment="Center">
                        <TextBlock Text="{Binding SkipText}" TextAlignment="Center" TextWrapping="Wrap" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
