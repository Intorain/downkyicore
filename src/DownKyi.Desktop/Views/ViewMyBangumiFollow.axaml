<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DownKyi.ViewModels"
    xmlns:vmp="clr-namespace:DownKyi.Presentation"
    xmlns:custom="clr-namespace:DownKyi.CustomControl"
    xmlns:asyncImageLoader="clr-namespace:DownKyi.CustomControl.AsyncImageLoader"
    x:Class="DownKyi.Views.ViewMyBangumiFollow"
    Background="{DynamicResource SpacePaper}"
    mc:Ignorable="d"
    d:DesignWidth="840"
    d:DesignHeight="620"
    x:DataType="vm:ViewMyBangumiFollowViewModel">
    <UserControl.Resources>
        <ControlTheme
            x:Key="MediaListStyle"
            TargetType="{x:Type ListBoxItem}"
            BasedOn="{StaticResource PersonalCollectionItem}"
            x:DataType="vmp:BangumiFollowMedia">
            <Setter Property="IsSelected" Value="{Binding IsSelected}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border Name="ItemSurface" Margin="0,0,12,12" BorderThickness="0,0,0,1" CornerRadius="0">
                            <Grid Name="nameMediaPanel" Height="140" Margin="8" ColumnDefinitions="110,*">
                                <Border Name="NameCover" Grid.Column="0" Width="110" Height="140" HorizontalAlignment="Center" CornerRadius="0">
                                    <Border.Background>
                                        <!--  长宽比：1.6  -->
                                        <ImageBrush
                                            asyncImageLoader:ImageBrushLoader.Source="{Binding Cover}"
                                            asyncImageLoader:ImageBrushLoader.Width="110"
                                            asyncImageLoader:ImageBrushLoader.Height="140" />
                                    </Border.Background>
                                </Border>
                                <ContentControl
                                    Name="NameChecked"
                                    Grid.Column="0"
                                    Width="24"
                                    Height="24"
                                    Margin="10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    IsVisible="{Binding IsSelected}"
                                    Theme="{StaticResource PersonalSelectionMark}" />
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <Button Name="MediaTitleLink" Theme="{StaticResource PersonalMediaLink}" Command="{Binding TitleCommand}" AutomationProperties.Name="{Binding Title}">
                                        <TextBlock
                                            Name="nameTitle"
                                            Cursor="Hand"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding Title}">
                                        </TextBlock>
                                    </Button>
                                    <TextBlock
                                        Height="40"
                                        Margin="0,10,0,0"
                                        Foreground="{DynamicResource SpaceInk}"
                                        Text="{Binding Evaluate}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="WrapWithOverflow"
                                        ToolTip.Tip="{Binding Evaluate}" />
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <TextBlock Foreground="{DynamicResource SpaceMuted}" Text="{Binding SeasonTypeName}" />
                                        <TextBlock Margin="5,0" Foreground="{DynamicResource SpaceMuted}" Text="|" />
                                        <TextBlock Foreground="{DynamicResource SpaceMuted}" Text="{Binding Area}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <TextBlock Foreground="{DynamicResource SpaceMuted}" Text="{Binding Progress}" />
                                        <TextBlock Margin="5,0" Foreground="{DynamicResource SpaceMuted}" Text="|" />
                                        <TextBlock Foreground="{DynamicResource SpaceMuted}" Text="{Binding IndexShow}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style Selector="^ /template/ TextBlock#nameTitle:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource SpaceAccent}" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,*" Margin="24,18,24,20" Background="{DynamicResource SpacePaper}">
        <Grid
            Grid.Row="0"
            Name="PersonalPageHeader"
            ColumnDefinitions="Auto,*,Auto"
            MinHeight="124"
            Background="{DynamicResource SpaceAccent}">
            <ContentControl
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Width="240"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Theme="{StaticResource PersonalHeaderArtwork}" />
            <Button
                Grid.Column="0"
                Margin="12,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding BackSpaceCommand}"
                Theme="{StaticResource PersonalPosterNavigationButton}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ContentControl Width="24" Height="24">
                        <Path
                            Width="{Binding ArrowBack.Width}"
                            Height="{Binding ArrowBack.Height}"
                            Data="{Binding ArrowBack.Data}"
                            Fill="{DynamicResource SpaceCarbon}"
                            Stretch="None" />
                    </ContentControl>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="48"
                        FontWeight="Black"
                        Foreground="{DynamicResource SpaceCarbon}"
                        Text="{DynamicResource MyBangumiFollow}" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                Width="44"
                Height="44"
                Padding="10"
                Margin="12,0,20,0"
                Background="{DynamicResource SpaceCream}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Command="{Binding DownloadManagerCommand}"
                Theme="{StaticResource PersonalPosterNavigationButton}"
                ToolTip.Tip="{DynamicResource DownloadManager}">
                <ContentControl Width="24" Height="24">
                    <Path
                        Width="{Binding DownloadManage.Width}"
                        Height="{Binding DownloadManage.Height}"
                        Data="{Binding DownloadManage.Data}"
                        Fill="{DynamicResource SpaceCarbon}"
                        Stretch="Uniform" />
                </ContentControl>
            </Button>
        </Grid>
        <!--  顶部Tab  -->
        <ListBox
            Name="NameTabHeaders"
            Theme="{StaticResource PersonalTabs}"
            ItemContainerTheme="{StaticResource PersonalTabItem}"
            Margin="0,8,0,12"
            VerticalAlignment="Center"
            Grid.Row="1"
            BorderThickness="0"
            IsEnabled="{Binding IsEnabled}"
            ItemsSource="{Binding TabHeaders}"
            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            SelectedIndex="{Binding SelectTabId, Mode=TwoWay}">
            <Interaction.Behaviors>
                <EventTriggerBehavior EventName="SelectionChanged">
                    <InvokeCommandAction Command="{Binding TabHeadersCommand}" CommandParameter="{Binding ElementName=NameTabHeaders, Path=SelectedItem}" />
                </EventTriggerBehavior>
            </Interaction.Behaviors>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <Grid Grid.Row="2" IsVisible="{Binding ContentVisibility}" RowDefinitions="*,1,Auto">
            <ListBox
                x:Name="NameMedias"
                Grid.Row="0"
                BorderThickness="0"
                ItemContainerTheme="{StaticResource MediaListStyle}"
                ItemsSource="{Binding Medias}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionMode="Multiple,Toggle">
                <Interaction.Behaviors>
                    <EventTriggerBehavior EventName="SelectionChanged">
                        <InvokeCommandAction Command="{Binding MediasCommand}" CommandParameter="{Binding ElementName=NameMedias, Path=SelectedItems}" />
                    </EventTriggerBehavior>
                </Interaction.Behaviors>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Theme>
                    <ControlTheme TargetType="ListBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBox">
                                    <Border
                                        x:Name="Bd"
                                        Padding="0"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                        <ScrollViewer Focusable="False">
                                            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </ControlTheme>
                </ListBox.Theme>
            </ListBox>
            <TextBlock Grid.Row="1" Background="{DynamicResource SpaceRule}" />
            <Grid Grid.Row="2" Name="PersonalLibraryToolbar" RowDefinitions="Auto,48" ColumnDefinitions="Auto,*,Auto,Auto">
                <CheckBox
                    Theme="{StaticResource PersonalCheckBox}"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="16,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding SelectAllCommand}"
                    CommandParameter="{Binding ElementName=NameMedias, Path=SelectedItem}"
                    Content="{DynamicResource SelectAll}"
                    Foreground="{DynamicResource SpaceInk}"
                    IsChecked="{Binding IsSelectAll, Mode=TwoWay}" />
                <Grid
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !DownloadCommandGate.IsExecuting}">
                    <custom:CustomPager Classes="personal" Margin="0,8" DataContext="{Binding Pager}" />
                </Grid>
                <custom:DownloadPreparationStatus
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    CancelCommand="{Binding CancelDownloadPreparationCommand}"
                    IsActive="{Binding DownloadCommandGate.IsExecuting}" />
                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding AddToDownloadCommand}"
                    Content="{DynamicResource DownloadSelectedPublication}"
                    FontSize="12"
                    Theme="{StaticResource PersonalActionButton}" />
                <Button
                    Grid.Row="1"
                    Grid.Column="3"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Classes="secondary"
                    Command="{Binding AddAllToDownloadCommand}"
                    Content="{DynamicResource DownloadAllPublication}"
                    FontSize="12"
                    Theme="{StaticResource PersonalActionButton}" />
            </Grid>
        </Grid>
        <!--  加载gif  -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical"
            IsVisible="{Binding LoadingVisibility}">
            <custom:Loading Width="40" Height="40" Foreground="{DynamicResource SpaceAccent}" IsActive="{Binding Loading}" />
            <TextBlock Margin="0,10,0,0" FontSize="14" Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource PublicationWait}" />
        </StackPanel>
        <!--  没有数据提示  -->
        <ContentControl Theme="{StaticResource StudioEmptyState}" Grid.Row="2" IsVisible="{Binding NoDataVisibility}" />
    </Grid>
</UserControl>
