<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DownKyi.Views.ViewFriends"
             Background="{DynamicResource SpacePaper}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="840"
             d:DesignHeight="620"
             xmlns:vm="clr-namespace:DownKyi.ViewModels"
             xmlns:vmp="clr-namespace:DownKyi.Presentation"
             x:DataType="vm:ViewFriendsViewModel">
    <Grid RowDefinitions="Auto,Auto,*" Margin="24,18,24,20" Background="{DynamicResource SpacePaper}">
        <Grid Grid.Row="0" Name="PersonalPageHeader" ColumnDefinitions="Auto,*,Auto" MinHeight="124" Background="{DynamicResource SpaceAccent}">
            <ContentControl Grid.Column="1" Grid.ColumnSpan="2" Width="240"
                            HorizontalAlignment="Right" VerticalAlignment="Stretch"
                            Theme="{StaticResource PersonalHeaderArtwork}" />

            <Button
                Grid.Column="0"
                Margin="12,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding BackSpaceCommand}"
                Theme="{StaticResource PersonalPosterNavigationButton}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ContentControl Width="24" Height="24">
                        <Path
                            Width="{Binding ArrowBack.Width}"
                            Height="{Binding ArrowBack.Height}"
                            Data="{Binding ArrowBack.Data}"
                            Fill="{DynamicResource SpaceCarbon}"
                            Stretch="None" />
                    </ContentControl>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="48"
                        FontWeight="Black"
                        Foreground="{DynamicResource SpaceCarbon}"
                        Text="{DynamicResource Friend}" />
                </StackPanel>
            </Button>
        </Grid>
        <!--  顶部Tab  -->
        <ListBox
            Name="NameTabHeaders"
            Theme="{StaticResource PersonalTabs}"
            ItemContainerTheme="{StaticResource PersonalTabItem}"
            Margin="0,8,0,12"
            VerticalAlignment="Center"
            Grid.Row="1"
            BorderThickness="0"
            ItemsSource="{Binding TabHeaders}"
            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            SelectedIndex="{Binding SelectTabId, Mode=TwoWay}">
            <Interaction.Behaviors>
                <EventTriggerBehavior EventName="SelectionChanged">
                    <InvokeCommandAction Command="{Binding TabHeadersCommand}"
                                         CommandParameter="{Binding ElementName=NameTabHeaders, Path=SelectedItem}" />
                </EventTriggerBehavior>
            </Interaction.Behaviors>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!--  内容区  -->
        <ContentControl Grid.Row="2" Content="{Binding RegionContent}" />
    </Grid>
</UserControl>
