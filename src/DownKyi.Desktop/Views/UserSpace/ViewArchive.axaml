<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vmu="clr-namespace:DownKyi.ViewModels.UserSpace"
    x:Class="DownKyi.Views.UserSpace.ViewArchive"
    x:DataType="vmu:ViewArchiveViewModel"
    Classes="studio-page">
    <UserControl.Styles>
        <StyleInclude Source="/Themes/Styles/Studio.axaml" />
    </UserControl.Styles>
    <Grid RowDefinitions="*">
        <ListBox
            Name="NamePublicationZones"
            Margin="0"
            ItemsSource="{Binding PublicationZones}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectedIndex="{Binding SelectedItem}"
            Background="Transparent">
            <Interaction.Behaviors>
                <EventTriggerBehavior EventName="SelectionChanged">
                    <InvokeCommandAction
                        Command="{Binding PublicationZonesCommand}"
                        CommandParameter="{Binding ElementName=NamePublicationZones, Path=SelectedItem}" />
                </EventTriggerBehavior>
            </Interaction.Behaviors>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Theme>
                <ControlTheme TargetType="ListBox">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBox">
                                <Border
                                    x:Name="Bd"
                                    Padding="0"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                    <ScrollViewer Focusable="False">
                                        <ItemsPresenter
                                            VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                            HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                                    </ScrollViewer>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </ControlTheme>
            </ListBox.Theme>
            <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SpaceRule}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}" x:DataType="vmu:PublicationZone">
                                <Border Margin="0,12,24,20" Width="208" Padding="12" Cursor="Hand"
                                        Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Count}" FontSize="30" FontWeight="Bold" FontFamily="Cascadia Mono,Consolas" Foreground="{DynamicResource SpaceInk}" Margin="0,0,0,12" />
                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                            <TextBlock Name="nameZoneName" FontSize="16" Foreground="{DynamicResource SpaceInk}" Text="{Binding Name}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style Selector="^:pointerover">
                        <Setter Property="Background" Value="{DynamicResource SpaceHover}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SpaceAccent}" />
                    </Style>
                    <Style Selector="^:focus-visible">
                        <Setter Property="Background" Value="{DynamicResource SpaceSelection}" />
                    </Style>
                </ControlTheme>
            </ListBox.ItemContainerTheme>
        </ListBox>
    </Grid>
</UserControl>
