<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:DownKyi.ViewModels.Toolbox"
    x:Class="DownKyi.Views.Toolbox.ViewExtractMedia"
    x:DataType="vm:ViewExtractMediaViewModel"
    Background="{DynamicResource SpacePaper}"
    Foreground="{DynamicResource SpaceInk}"
    Classes="studio-page">
    <UserControl.Styles>
        <StyleInclude Source="/Themes/Styles/Studio.axaml" />
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid
            Margin="24,8,24,28"
            RowDefinitions="Auto,Auto,Auto"
            MaxWidth="1100"
            HorizontalAlignment="Stretch">
            <TextBlock
                Name="NameExtractMediaTitle"
                Foreground="{DynamicResource SpaceInk}"
                Text="{DynamicResource ExtractMedia}"
                Classes="studio-title" />
            <Border
                Name="NameExtractionWorkflow"
                Grid.Row="1"
                Margin="0,24,0,0"
                Padding="0,20,0,24"
                Background="{DynamicResource SpacePaper}"
                BorderBrush="{DynamicResource SpaceRule}"
                BorderThickness="0,1,0,1"
                CornerRadius="0">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource VideoFilePath}" />
                    <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto">
                        <TextBox
                            Name="NameVideoPaths"
                            Grid.Column="0"
                            Height="72"
                            Padding="12,8"
                            VerticalContentAlignment="Top"
                            IsReadOnly="True"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Text="{Binding VideoPathsStr, Mode=TwoWay}" />
                        <Button
                            Name="NameSelectVideoButton"
                            Grid.Column="1"
                            Height="36"
                            MinWidth="112"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding SelectVideoCommand}"
                            Content="{DynamicResource SelectVideo}" />
                    </Grid>
                    <Grid Name="NameExtractActions" Margin="0,16,0,0" ColumnDefinitions="*,12,*">
                        <Button
                            Name="NameExtractAudioButton"
                            Grid.Column="0"
                            Height="40"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ExtractAudioCommand}"
                            Content="{DynamicResource ExtractAudio}"
                            Classes="studio-primary" />
                        <Button
                            Name="NameExtractVideoButton"
                            Grid.Column="2"
                            Height="40"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ExtractVideoCommand}"
                            Content="{DynamicResource ExtractVideo}" />
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,24,0,0">
                <TextBlock Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource OutputInfo}" />
                <TextBox
                    Name="NameStatus"
                    Classes="studio-output"
                    Height="200"
                    Margin="0,8,0,0"
                    Background="{DynamicResource SpaceHover}"
                    BorderBrush="{DynamicResource SpaceRule}"
                    Foreground="{DynamicResource SpaceInk}"
                    IsReadOnly="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{Binding Status, Mode=TwoWay}">
                    <Interaction.Behaviors>
                        <EventTriggerBehavior EventName="TextChanged">
                            <InvokeCommandAction Command="{Binding StatusCommand}" CommandParameter="{Binding $self}" />
                        </EventTriggerBehavior>
                    </Interaction.Behaviors>
                </TextBox>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
