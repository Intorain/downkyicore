<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="clr-namespace:DownKyi.ViewModels.Settings"
    x:Class="DownKyi.Views.Settings.ViewVideo"
    x:DataType="vms:ViewVideoViewModel"
    Classes="studio-page">
    <UserControl.Styles>
        <StyleInclude Source="/Themes/Styles/Studio.axaml" />
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="24,8,24,28"
            Orientation="Vertical"
            MaxWidth="1100"
            HorizontalAlignment="Stretch">
            <TextBlock
                Name="NameVideoPageTitle"
                Margin="0,20,0,0"
                Foreground="{DynamicResource SpaceInk}"
                Text="{DynamicResource Video}"
                Classes="studio-title" />
            <TextBlock
                Name="NameVideoDownloadPreferencesTitle"
                Margin="0,28,0,0"
                FontSize="{DynamicResource DownKyiFontSizeBody}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource SpaceInk}"
                Text="{DynamicResource VideoDownloadPreferences}"
                Classes=" studio-section" />
            <Grid
                Name="NameVideoDownloadPreferences"
                Margin="0,12,0,0"
                ColumnDefinitions="160,*"
                RowDefinitions="Auto,Auto,Auto"
                MaxWidth="720"
                HorizontalAlignment="Left" Width="{Binding $parent[StackPanel].Bounds.Width}">
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,12"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource DownKyiFontSizeBody}"
                    Foreground="{DynamicResource SpaceInk}"
                    Text="{DynamicResource FirstVideoCodecs}" />
                <ComboBox
                    Name="NameVideoCodecs"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    DisplayMemberBinding="{ReflectionBinding Name}"
                    ItemsSource="{Binding VideoCodecs}"
                    SelectedValue="{Binding SelectedVideoCodec}">
                    <Interaction.Behaviors>
                        <EventTriggerBehavior EventName="SelectionChanged">
                            <InvokeCommandAction Command="{Binding VideoCodecsCommand}" CommandParameter="{Binding ElementName=NameVideoCodecs,Path=SelectedValue}" />
                        </EventTriggerBehavior>
                    </Interaction.Behaviors>
                </ComboBox>
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,0,12"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource DownKyiFontSizeBody}"
                    Foreground="{DynamicResource SpaceInk}"
                    Text="{DynamicResource FirstVideoQuality}" />
                <ComboBox
                    Name="NameVideoQualityList"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    DisplayMemberBinding="{ReflectionBinding Name}"
                    ItemsSource="{Binding VideoQualityList}"
                    SelectedItem="{Binding SelectedVideoQuality}">
                    <Interaction.Behaviors>
                        <EventTriggerBehavior EventName="SelectionChanged">
                            <InvokeCommandAction Command="{Binding VideoQualityCommand}" CommandParameter="{Binding ElementName=NameVideoQualityList,Path=SelectedValue}" />
                        </EventTriggerBehavior>
                    </Interaction.Behaviors>
                </ComboBox>
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,0,0,12"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource DownKyiFontSizeBody}"
                    Foreground="{DynamicResource SpaceInk}"
                    Text="{DynamicResource FirstAudioQuality}" />
                <ComboBox
                    Name="NameAudioQualityList"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    DisplayMemberBinding="{ReflectionBinding Name}"
                    ItemsSource="{Binding AudioQualityList}"
                    SelectedItem="{Binding SelectedAudioQuality}">
                    <Interaction.Behaviors>
                        <EventTriggerBehavior EventName="SelectionChanged">
                            <InvokeCommandAction Command="{Binding AudioQualityCommand}" CommandParameter="{Binding ElementName=NameAudioQualityList,Path=SelectedValue}" />
                        </EventTriggerBehavior>
                    </Interaction.Behaviors>
                </ComboBox>
            </Grid>
            <TextBlock
                Name="NameVideoPostProcessingTitle"
                Margin="0,28,0,0"
                FontSize="{DynamicResource DownKyiFontSizeBody}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource SpaceInk}"
                Text="{DynamicResource VideoPostProcessing}"
                Classes=" studio-section" />
            <StackPanel Name="NameVideoPostProcessing" Margin="0,12,0,0">
                <CheckBox
                    Name="NameTranscodeFlvToMp4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding IsTranscodingFlvToMp4Command}"
                    Content="{DynamicResource IsTranscodingFlvToMp4}"
                    FontSize="{DynamicResource DownKyiFontSizeBody}"
                    Foreground="{DynamicResource SpaceInk}"
                    IsChecked="{Binding IsTranscodingFlvToMp4, Mode=TwoWay}" />
                <CheckBox
                    Name="NameTranscodeAacToMp3"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding IsTranscodingAacToMp3Command}"
                    Content="{DynamicResource IsTranscodingAacToMp3}"
                    FontSize="{DynamicResource DownKyiFontSizeBody}"
                    Foreground="{DynamicResource SpaceInk}"
                    IsChecked="{Binding IsTranscodingAacToMp3, Mode=TwoWay}" />
            </StackPanel>
            <TextBlock
                Name="NameVideoFfmpegTitle"
                Margin="0,28,0,0"
                FontSize="{DynamicResource DownKyiFontSizeBody}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource SpaceInk}"
                Text="{DynamicResource VideoFfmpegSettings}"
                Classes=" studio-section" />
            <Grid
                Name="NameVideoFfmpegSettings"
                Margin="0,12,0,0"
                ColumnDefinitions="160,*"
                RowDefinitions="Auto,Auto"
                MaxWidth="720"
                HorizontalAlignment="Left" Width="{Binding $parent[StackPanel].Bounds.Width}">
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,12"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource DownKyiFontSizeBody}"
                    Foreground="{DynamicResource SpaceInk}"
                    Text="{DynamicResource FfmpegHardwareAcceleration}"
                    ToolTip.Tip="{DynamicResource FfmpegHardwareAccelerationTip}" />
                <ComboBox
                    Name="NameFfmpegHardwareAcceleration"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    DisplayMemberBinding="{Binding Name}"
                    ItemsSource="{Binding FfmpegHardwareAccelerations}"
                    SelectedItem="{Binding SelectedFfmpegHardwareAcceleration}"
                    ToolTip.Tip="{DynamicResource FfmpegHardwareAccelerationTip}">
                    <Interaction.Behaviors>
                        <EventTriggerBehavior EventName="SelectionChanged">
                            <InvokeCommandAction Command="{Binding FfmpegHardwareAccelerationCommand}" CommandParameter="{Binding ElementName=NameFfmpegHardwareAcceleration,Path=SelectedValue}" />
                        </EventTriggerBehavior>
                    </Interaction.Behaviors>
                </ComboBox>
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource DownKyiFontSizeBody}"
                    Foreground="{DynamicResource SpaceInk}"
                    Text="{DynamicResource FfmpegMaxParallelJobs}"
                    ToolTip.Tip="{DynamicResource FfmpegMaxParallelJobsTip}" />
                <ComboBox
                    Name="NameFfmpegMaxParallelJobs"
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="120"
                    HorizontalAlignment="Left"
                    VerticalContentAlignment="Center"
                    ItemsSource="{Binding FfmpegMaxParallelJobs}"
                    SelectedValue="{Binding SelectedFfmpegMaxParallelJob}"
                    ToolTip.Tip="{DynamicResource FfmpegMaxParallelJobsTip}">
                    <Interaction.Behaviors>
                        <EventTriggerBehavior EventName="SelectionChanged">
                            <InvokeCommandAction Command="{Binding FfmpegMaxParallelJobsCommand}" CommandParameter="{Binding ElementName=NameFfmpegMaxParallelJobs,Path=SelectedValue}" />
                        </EventTriggerBehavior>
                    </Interaction.Behaviors>
                </ComboBox>
            </Grid>
            <StackPanel Margin="0,32,0,0" Orientation="Vertical">
                <WrapPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource DownKyiFontSizeBody}"
                        Foreground="{DynamicResource SpaceInk}"
                        Text="{DynamicResource DefaultDirectory}"
                        Margin="0,0,20,8" />
                    <TextBlock
                        Margin="0,0,20,8"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource DownKyiFontSizeBody}"
                        Foreground="{DynamicResource SpaceMuted}"
                        Text="{DynamicResource DefaultDirectoryTip}" />
                </WrapPanel>
                <Grid Margin="0,10,0,0" ColumnDefinitions="*,Auto">
                    <TextBlock
                        MaxWidth="600" HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource DownKyiFontSizeBody}"
                        Foreground="{DynamicResource SpaceInk}"
                        Text="{Binding SaveVideoDirectory}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip.Tip="{Binding SaveVideoDirectory}" />
                    <Button
                        Margin="30,0,0,0"
                        Command="{Binding ChangeSaveVideoDirectoryCommand}"
                        Content="{DynamicResource ChangeDirectory}"
                        FontSize="{DynamicResource DownKyiFontSizeBody}"
                        Grid.Column="1" />
                </Grid>
            </StackPanel>
            <WrapPanel Margin="0,20,0,0" Orientation="Horizontal">
                <CheckBox
                    Command="{Binding GenerateMovieMetadataCommand }"
                    IsChecked="{Binding GenerateMovieMetadata}"
                    Content="{DynamicResource GenerateVideoMetadata}"
                    FontSize="{DynamicResource DownKyiFontSizeBody}"
                    ToolTip.Tip="nfo"
                    Foreground="{DynamicResource SpaceInk}"
                    Margin="0,0,20,8" />
            </WrapPanel>
            <HeaderedContentControl
                Header="{DynamicResource DownloadContent2}"
                Background="Transparent"
                Margin="0,20,0,0"
                Foreground="{DynamicResource SpaceInk}"
                CornerRadius="0"
                FontSize="{DynamicResource DownKyiFontSizeBody}">
                <StackPanel Margin="10" Spacing="12">
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox
                            Command="{Binding DownloadAllCommand}"
                            Content="{DynamicResource DownloadAll}"
                            Foreground="{DynamicResource SpaceInk}"
                            IsChecked="{Binding DownloadAll, Mode=TwoWay}"
                            Margin="0,0,20,8" />
                        <CheckBox
                            Margin="0,0,20,8"
                            Command="{Binding ContentSelectionChangedCommand}"
                            Content="{DynamicResource DownloadAudio}"
                            Foreground="{DynamicResource SpaceInk}"
                            IsChecked="{Binding DownloadAudio, Mode=TwoWay}" />
                        <CheckBox
                            Margin="0,0,20,8"
                            Command="{Binding ContentSelectionChangedCommand}"
                            Content="{DynamicResource DownloadVideo}"
                            Foreground="{DynamicResource SpaceInk}"
                            IsChecked="{Binding DownloadVideo, Mode=TwoWay}" />
                        <CheckBox
                            Margin="0,0,20,8"
                            Command="{Binding ContentSelectionChangedCommand}"
                            Content="{DynamicResource DownloadDanmaku}"
                            Foreground="{DynamicResource SpaceInk}"
                            IsChecked="{Binding DownloadDanmaku, Mode=TwoWay}" />
                        <CheckBox
                            Margin="0,0,20,8"
                            Command="{Binding ContentSelectionChangedCommand}"
                            Content="{DynamicResource DownloadSubtitle}"
                            Foreground="{DynamicResource SpaceInk}"
                            IsChecked="{Binding DownloadSubtitle, Mode=TwoWay}" />
                        <CheckBox
                            Margin="0,0,20,8"
                            Command="{Binding ContentSelectionChangedCommand}"
                            Content="{DynamicResource DownloadCover}"
                            Foreground="{DynamicResource SpaceInk}"
                            IsChecked="{Binding DownloadCover, Mode=TwoWay}" />
                    </WrapPanel>
                    <Grid
                        Margin="0"
                        ColumnDefinitions="150,*"
                        IsEnabled="{Binding DownloadSubtitle}"
                        RowDefinitions="Auto,Auto"
                        MaxWidth="720" Width="{Binding $parent[StackPanel].Bounds.Width}" HorizontalAlignment="Left">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource SpaceInk}"
                            Text="{DynamicResource PreferredSubtitleLanguage}"
                            Margin="0,0,12,10" />
                        <ComboBox
                            x:Name="PreferredSubtitleLanguageSelector"
                            Grid.Column="1"
                            Margin="0,0,12,10"
                            DisplayMemberBinding="{Binding Name}"
                            ItemsSource="{Binding SubtitleLanguagePreferences}"
                            SelectedItem="{Binding SelectedSubtitleLanguagePreference}">
                            <Interaction.Behaviors>
                                <EventTriggerBehavior EventName="SelectionChanged">
                                    <InvokeCommandAction Command="{Binding SubtitlePreferenceCommand}" />
                                </EventTriggerBehavior>
                            </Interaction.Behaviors>
                        </ComboBox>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource SpaceInk}"
                            Text="{DynamicResource PreferredSubtitleType}"
                            Grid.Row="1"
                            Margin="0,0,12,10" />
                        <ComboBox
                            x:Name="PreferredSubtitleTypeSelector"
                            Grid.Column="1"
                            Margin="0,0,12,10"
                            DisplayMemberBinding="{Binding Name}"
                            ItemsSource="{Binding SubtitleTypePreferences}"
                            SelectedItem="{Binding SelectedSubtitleTypePreference}"
                            Grid.Row="1">
                            <Interaction.Behaviors>
                                <EventTriggerBehavior EventName="SelectionChanged">
                                    <InvokeCommandAction Command="{Binding SubtitlePreferenceCommand}" />
                                </EventTriggerBehavior>
                            </Interaction.Behaviors>
                        </ComboBox>
                    </Grid>
                    <TextBlock
                        Margin="24,0,0,0"
                        Foreground="{DynamicResource SpaceMuted}"
                        Text="{DynamicResource SubtitlePreferenceTip}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl
                Header="{DynamicResource FileNameParts}"
                Background="Transparent"
                Margin="0,20,0,0"
                Foreground="{DynamicResource SpaceInk}"
                CornerRadius="0"
                FontSize="{DynamicResource DownKyiFontSizeBody}">
                <Grid ColumnDefinitions="100,*" RowDefinitions="*,*,*" Margin="10">
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        FontSize="{DynamicResource DownKyiFontSizeBody}"
                        Foreground="{DynamicResource SpaceInk}"
                        Text="{DynamicResource OptionalFields}" />
                    <ListBox Classes="studio-fields"
                        Name="NameOptionalFields"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,20"
                        ItemContainerTheme="{StaticResource TagItem2Style}"
                        ItemsSource="{Binding OptionalFields, Mode=TwoWay}"
                        SelectedIndex="{Binding SelectedOptionalField}"
                        SelectionMode="Single"
                        Theme="{StaticResource Tag2Style}">
                        <Interaction.Behaviors>
                            <EventTriggerBehavior EventName="SelectionChanged">
                                <InvokeCommandAction Command="{Binding OptionalFieldsCommand}" CommandParameter="{Binding ElementName=NameOptionalFields, Path=SelectedItem}" />
                            </EventTriggerBehavior>
                        </Interaction.Behaviors>
                    </ListBox>
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        FontSize="{DynamicResource DownKyiFontSizeBody}"
                        Foreground="{DynamicResource SpaceInk}"
                        Text="{DynamicResource FileName}" />
                    <ListBox Classes="studio-fields"
                        x:Name="NameSelectedFileName"
                        Grid.Row="1"
                        Grid.Column="1"
                        MinHeight="30"
                        ItemsSource="{Binding SelectedFileName, Mode=TwoWay}"
                        SelectionMode="Single"
                        Theme="{StaticResource Tag2Style}">
                        <Interaction.Behaviors>
                            <EventTriggerBehavior EventName="DoubleTapped">
                                <InvokeCommandAction Command="{Binding SelectedFileNameRightCommand}" CommandParameter="{Binding ElementName=NameSelectedFileName, Path=SelectedItem}" />
                            </EventTriggerBehavior>
                        </Interaction.Behaviors>
                        <ListBox.ItemContainerTheme>
                            <ControlTheme BasedOn="{StaticResource TagItem2Style}" TargetType="{x:Type ListBoxItem}">
                                <Setter Property="DragDrop.AllowDrop" Value="True" />
                                <Setter Property="(Interaction.Behaviors)">
                                    <BehaviorCollectionTemplate>
                                        <BehaviorCollection>
                                            <ItemDragBehavior Orientation="Horizontal" />
                                        </BehaviorCollection>
                                    </BehaviorCollectionTemplate>
                                </Setter>
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                    </ListBox>
                    <Grid
                        Name="NameFileNameEditorOptions"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,20,0,0"
                        ColumnDefinitions="120,*,Auto"
                        RowDefinitions="Auto,Auto"
                        >
                        <TextBlock
                            Name="NameFileNamePartTimeFormatLabel"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource DownKyiFontSizeBody}"
                            Foreground="{DynamicResource SpaceInk}"
                            Text="{DynamicResource FileNameTimeFormat}"
                            Margin="0,0,12,12" />
                        <ComboBox
                            Name="NameFileNamePartTimeFormat"
                            Grid.Column="1"
                            Width="140"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            ItemsSource="{Binding FileNamePartTimeFormatList}"
                            SelectedItem="{Binding SelectedFileNamePartTimeFormat}"
                            Margin="0,0,12,12">
                            <Interaction.Behaviors>
                                <EventTriggerBehavior EventName="SelectionChanged">
                                    <InvokeCommandAction Command="{Binding FileNamePartTimeFormatCommand}" CommandParameter="{Binding ElementName=NameFileNamePartTimeFormat, Path=SelectedItem}" />
                                </EventTriggerBehavior>
                            </Interaction.Behaviors>
                        </ComboBox>
                        <TextBlock
                            Name="NameOrderFormatLabel"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource DownKyiFontSizeBody}"
                            Foreground="{DynamicResource SpaceInk}"
                            Text="{DynamicResource OrderFormat}"
                            Grid.Row="1"
                            Margin="0,0,12,12" />
                        <ComboBox
                            Name="NameOrderFormat"
                            Grid.Column="1"
                            Width="140"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            DisplayMemberBinding="{Binding Name}"
                            ItemsSource="{Binding OrderFormatList}"
                            SelectedItem="{Binding OrderFormatDisplay}"
                            Grid.Row="1"
                            Margin="0,0,12,12">
                            <Interaction.Behaviors>
                                <EventTriggerBehavior EventName="SelectionChanged">
                                    <InvokeCommandAction Command="{Binding OrderFormatCommand}" CommandParameter="{Binding ElementName=NameOrderFormat, Path=SelectedItem}" />
                                </EventTriggerBehavior>
                            </Interaction.Behaviors>
                        </ComboBox>
                        <Button
                            Name="NameResetFileNameButton"
                            Grid.Column="2"
                            MinWidth="92"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding ResetCommand}"
                            Content="{DynamicResource Reset}"
                            FontSize="{DynamicResource DownKyiFontSizeBody}"
                            Grid.RowSpan="2"
                            Margin="0,0,12,12" />
                    </Grid>
                </Grid>
            </HeaderedContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
