<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="clr-namespace:DownKyi.ViewModels.Settings"
    x:Class="DownKyi.Views.Settings.ViewAbout"
    x:DataType="vms:ViewAboutViewModel"
    Classes="studio-page">
    <UserControl.Styles>
        <StyleInclude Source="/Themes/Styles/Studio.axaml" />
        <Style Selector="Button.link">
            <Setter Property="Foreground" Value="{DynamicResource SpaceAccent}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}">
                        <ContentPresenter.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
                                <Setter Property="FontSize" Value="{TemplateBinding FontSize}" />
                                <Setter Property="TextDecorations" Value="Underline" />
                            </Style>
                        </ContentPresenter.Styles>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TextBlock.disclaimer-item">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="{DynamicResource DownKyiFontSizeBody}" />
            <Setter Property="Foreground" Value="{DynamicResource SpaceMuted}" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="TextWrapping" Value="WrapWithOverflow" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="24,8,24,28"
            Orientation="Vertical"
            MaxWidth="1100"
            HorizontalAlignment="Stretch">
            <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource About}" Classes="studio-title" />
                <TextBlock
                    Cursor="Hand"
                    Foreground="{DynamicResource SpaceAccent}"
                    Text="{Binding AppName}"
                    Classes="studio-title">
                    <Interaction.Behaviors>
                        <EventTriggerBehavior EventName="PointerReleased">
                            <InvokeCommandAction Command="{Binding AppNameCommand}" />
                        </EventTriggerBehavior>
                    </Interaction.Behaviors>
                </TextBlock>
            </StackPanel>
            <StackPanel Margin="0,24,0,0" Orientation="Vertical">
                <TextBlock
                    x:Name="NameVersionInformationTitle"
                    FontSize="{DynamicResource DownKyiFontSizeSectionTitle}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource SpaceInk}"
                    Text="{DynamicResource VersionInformation}"
                    Classes=" studio-section" />
                <StackPanel x:Name="NameVersionActions" Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource DownKyiFontSizeBody}"
                        Foreground="{DynamicResource SpaceInk}"
                        Text="{DynamicResource CurrentAppVersion}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource DownKyiFontSizeBody}"
                        Foreground="{DynamicResource SpaceInk}"
                        Text="{Binding AppVersion}" />
                    <Button
                        x:Name="NameCheckUpdateButton"
                        MinWidth="96"
                        Margin="16,0,0,0"
                        Command="{Binding CheckUpdateCommand}"
                        Content="{DynamicResource CheckUpdate}"
                        FontSize="{DynamicResource DownKyiFontSizeBody}"
                        Classes="studio-primary" />
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,24,0,0" Orientation="Vertical">
                <TextBlock
                    x:Name="NameFeedbackAndDiagnosticsTitle"
                    FontSize="{DynamicResource DownKyiFontSizeSectionTitle}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource SpaceInk}"
                    Text="{DynamicResource FeedbackAndDiagnostics}"
                    Classes=" studio-section" />
                <TextBlock
                    x:Name="NameFeedbackSupportTip"
                    Margin="0,6,0,0"
                    FontSize="{DynamicResource DownKyiFontSizeBody}"
                    Foreground="{DynamicResource SpaceMuted}"
                    Text="{DynamicResource FeedbackSupportTip}"
                    TextWrapping="WrapWithOverflow" />
                <WrapPanel x:Name="NameFeedbackActions" Margin="0,10,0,0" Orientation="Horizontal">
                    <Button
                        x:Name="NameFeedbackButton"
                        MinWidth="96"
                        Command="{Binding FeedbackCommand}"
                        Content="{DynamicResource FeedbackProblem}"
                        FontSize="{DynamicResource DownKyiFontSizeBody}"
                        Margin="0,0,12,8" />
                    <Button
                        x:Name="NameOpenLogsButton"
                        MinWidth="100"
                        Margin="0,0,12,8"
                        Command="{Binding OpenLogsCommand}"
                        Content="{DynamicResource OpenLogs}"
                        FontSize="{DynamicResource DownKyiFontSizeBody}" />
                    <Button
                        x:Name="NameExportDiagnosticLogButton"
                        MinWidth="120"
                        Margin="0,0,12,8"
                        Command="{Binding ExportDiagnosticLogCommand}"
                        Content="{DynamicResource ExportDiagnosticLog}"
                        FontSize="{DynamicResource DownKyiFontSizeBody}" />
                </WrapPanel>
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="{DynamicResource DownKyiFontSizeBody}"
                    Foreground="{DynamicResource SpaceMuted}"
                    Text="{DynamicResource DiagnosticLogTip}"
                    TextWrapping="WrapWithOverflow" />
            </StackPanel>
            <CheckBox
                Grid.Column="0"
                Margin="0,20,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Command="{Binding ReceiveBetaVersionCommand}"
                Content="{DynamicResource ReceiveBetaVersion}"
                Foreground="{DynamicResource SpaceInk}"
                IsChecked="{Binding IsReceiveBetaVersion, Mode=TwoWay}" />
            <CheckBox
                Margin="0,20,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Command="{Binding AutoUpdateWhenLaunchCommand}"
                Content="{DynamicResource AutoUpdateWhenLaunch}"
                Foreground="{DynamicResource SpaceInk}"
                IsChecked="{Binding AutoUpdateWhenLaunch, Mode=TwoWay}" />
            <!--  免责申明  -->
            <StackPanel
                x:Name="NameDisclaimerSection"
                MaxWidth="880"
                Margin="0,28,0,0"
                HorizontalAlignment="Left"
                Orientation="Vertical">
                <TextBlock
                    x:Name="NameDisclaimerTitle"
                    Margin="0,0,0,12"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource SpaceInk}"
                    Text="{DynamicResource Disclaimer}"
                    Classes=" studio-section" />
                <StackPanel x:Name="NameDisclaimerItems">
                    <TextBlock Classes="disclaimer-item" Text="{DynamicResource Disclaimer1}" />
                    <TextBlock Classes="disclaimer-item" Text="{DynamicResource Disclaimer2}" />
                    <TextBlock Classes="disclaimer-item" Text="{DynamicResource Disclaimer3}" />
                    <TextBlock Classes="disclaimer-item" Text="{DynamicResource Disclaimer4}" />
                    <TextBlock Classes="disclaimer-item" Text="{DynamicResource Disclaimer5}" />
                    <TextBlock Classes="disclaimer-item" Text="{DynamicResource Disclaimer6}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="10" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
