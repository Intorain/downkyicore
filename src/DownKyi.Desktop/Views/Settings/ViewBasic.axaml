<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="clr-namespace:DownKyi.ViewModels.Settings"
    xmlns:settings="clr-namespace:DownKyi.Application.Settings;assembly=DownKyi.Application"
    x:Class="DownKyi.Views.Settings.ViewBasic"
    x:DataType="vms:ViewBasicViewModel"
    Classes="studio-page">
    <UserControl.Styles>
        <StyleInclude Source="/Themes/Styles/Studio.axaml" />
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="24,8,24,28"
            Orientation="Vertical"
            MaxWidth="1100"
            HorizontalAlignment="Stretch">
            <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource Basic}" Classes="studio-title" />
            </StackPanel>
            <StackPanel Margin="0,20,0,0" Orientation="Vertical" IsVisible="False">
                <TextBlock FontSize="{DynamicResource DownKyiFontSizeBody}" Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource AfterDownloadOperation}" />
                <WrapPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <RadioButton
                        Command="{Binding AfterDownloadOperationCommand}"
                        CommandParameter="None"
                        GroupName="AfterDownloadOperation"
                        Foreground="{DynamicResource SpaceInk}"
                        FontSize="{DynamicResource DownKyiFontSizeBody}"
                        Content="{StaticResource AfterDownloadOperationNone}"
                        IsChecked="{Binding None}"
                        Theme="{StaticResource RadioStyle}"
                        Margin="0,0,24,8" />
                    <RadioButton
                        Margin="0,0,24,8"
                        GroupName="AfterDownloadOperation"
                        Foreground="{DynamicResource SpaceInk}"
                        FontSize="{DynamicResource DownKyiFontSizeBody}"
                        Command="{Binding AfterDownloadOperationCommand}"
                        CommandParameter="CloseApp"
                        IsChecked="{Binding CloseApp}"
                        Content="{StaticResource AfterDownloadOperationCloseApp}"
                        Theme="{StaticResource RadioStyle}" />
                    <RadioButton
                        Margin="0,0,24,8"
                        GroupName="AfterDownloadOperation"
                        Foreground="{DynamicResource SpaceInk}"
                        FontSize="{DynamicResource DownKyiFontSizeBody}"
                        Command="{Binding AfterDownloadOperationCommand}"
                        CommandParameter="CloseSystem"
                        IsChecked="{Binding CloseSystem}"
                        Content="{StaticResource AfterDownloadOperationCloseSystem}"
                        Theme="{StaticResource RadioStyle}" />
                </WrapPanel>
            </StackPanel>
            <StackPanel Margin="0,20,0,0" Orientation="Vertical">
                <TextBlock FontSize="{DynamicResource DownKyiFontSizeBody}" Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource Theme}" />
                <WrapPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <RadioButton
                        Command="{Binding ThemeCommand}"
                        CommandParameter="{x:Static settings:ThemeMode.Light}"
                        GroupName="Theme"
                        Foreground="{DynamicResource SpaceInk}"
                        FontSize="{DynamicResource DownKyiFontSizeBody}"
                        Content="{StaticResource ThemeLight}"
                        IsChecked="{Binding ThemeLight}"
                        Margin="0,0,24,8" />
                    <RadioButton
                        Margin="0,0,24,8"
                        GroupName="Theme"
                        Foreground="{DynamicResource SpaceInk}"
                        FontSize="{DynamicResource DownKyiFontSizeBody}"
                        Command="{Binding ThemeCommand}"
                        CommandParameter="{x:Static settings:ThemeMode.Dark}"
                        IsChecked="{Binding ThemeDark}"
                        Content="{StaticResource ThemeDark}" />
                    <RadioButton
                        Margin="0,0,24,8"
                        GroupName="Theme"
                        Foreground="{DynamicResource SpaceInk}"
                        FontSize="{DynamicResource DownKyiFontSizeBody}"
                        Command="{Binding ThemeCommand}"
                        CommandParameter="{x:Static settings:ThemeMode.Default}"
                        IsChecked="{Binding ThemeAuto}"
                        Content="{StaticResource ThemeAuto}" />
                </WrapPanel>
            </StackPanel>
            <StackPanel Margin="0,20,0,0" Orientation="Vertical">
                <TextBlock FontSize="{DynamicResource DownKyiFontSizeBody}" Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource InterfaceLanguage}" />
                <WrapPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <RadioButton GroupName="InterfaceLanguage" Command="{Binding LanguageCommand}" CommandParameter="{x:Static settings:UiLanguage.ChineseSimplified}" Content="简体中文" IsChecked="{Binding LanguageChineseSimplified}" Margin="0,0,24,8" />
                    <RadioButton GroupName="InterfaceLanguage" Command="{Binding LanguageCommand}" CommandParameter="{x:Static settings:UiLanguage.ChineseTraditional}" Content="繁體中文" IsChecked="{Binding LanguageChineseTraditional}" Margin="0,0,24,8" />
                    <RadioButton GroupName="InterfaceLanguage" Command="{Binding LanguageCommand}" CommandParameter="{x:Static settings:UiLanguage.English}" Content="English" IsChecked="{Binding LanguageEnglish}" Margin="0,0,24,8" />
                    <RadioButton GroupName="InterfaceLanguage" Command="{Binding LanguageCommand}" CommandParameter="{x:Static settings:UiLanguage.Japanese}" Content="日本語" IsChecked="{Binding LanguageJapanese}" Margin="0,0,24,8" />
                </WrapPanel>
                <TextBlock Foreground="{DynamicResource SpaceMuted}" Text="{DynamicResource LanguageRestartHint}" />
            </StackPanel>
            <TextBlock Height="1" Margin="0,20,0,0" Background="{DynamicResource SpaceRule}" />
            <CheckBox
                Margin="0,20,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Command="{Binding ListenClipboardCommand}"
                Content="{DynamicResource ListenClipboard}"
                Foreground="{DynamicResource SpaceInk}"
                IsChecked="{Binding ListenClipboard, Mode=TwoWay}" />
            <CheckBox
                Margin="0,20,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Command="{Binding RepeatFileAutoAddNumberSuffixCommand}"
                Content="{DynamicResource RepeatFileAutoAddNumberSuffix}"
                Foreground="{DynamicResource SpaceInk}"
                IsChecked="{Binding RepeatFileAutoAddNumberSuffix, Mode=TwoWay}" />
            <StackPanel Margin="10" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
