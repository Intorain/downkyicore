<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:DownKyi.Views.Settings"
    xmlns:vms="clr-namespace:DownKyi.ViewModels.Settings"
    x:Class="DownKyi.Views.Settings.ViewNetwork"
    x:DataType="vms:ViewNetworkViewModel"
    mc:Ignorable="d"
    d:DesignWidth="800"
    d:DesignHeight="1200"
    Classes="studio-page">
    <UserControl.Styles>
        <StyleInclude Source="/Themes/Styles/Studio.axaml" />
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Margin="24,8,24,28"
            Orientation="Vertical"
            MaxWidth="1100"
            HorizontalAlignment="Stretch">
            <views:NetworkGeneralSettingsView />
            <views:BuiltinDownloaderSettingsView />
            <StackPanel Margin="10" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
