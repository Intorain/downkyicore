<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="clr-namespace:DownKyi.ViewModels.Settings"
    x:Class="DownKyi.Views.Settings.BuiltinDownloaderSettingsView"
    x:DataType="vms:ViewNetworkViewModel"
    Classes="studio-page">
    <UserControl.Styles>
        <StyleInclude Source="/Themes/Styles/Studio.axaml" />
    </UserControl.Styles>
    <StackPanel x:Name="NameBuiltin">
        <TextBlock
            Name="NameBuiltinParametersTitle"
            Margin="0,28,0,0"
            FontSize="{DynamicResource DownKyiFontSizeBody}"
            FontWeight="SemiBold"
            Foreground="{DynamicResource SpaceInk}"
            Text="{DynamicResource BuiltinParametersSection}"
            Classes=" studio-section" />
        <Grid Margin="0,12,0,0" ColumnDefinitions="*,24,*">
            <StackPanel Grid.Column="0">
                <TextBlock FontSize="{DynamicResource DownKyiFontSizeBody}" Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource MaxCurrentDownloads}" />
                <ComboBox
                    Name="NameMaxCurrentDownloads"
                    Width="180"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    VerticalContentAlignment="Center"
                    ItemsSource="{Binding MaxCurrentDownloads}"
                    SelectedValue="{Binding SelectedMaxCurrentDownload,Mode=TwoWay}">
                    <Interaction.Behaviors>
                        <EventTriggerBehavior EventName="SelectionChanged">
                            <InvokeCommandAction Command="{Binding MaxCurrentDownloadsCommand}" CommandParameter="{Binding ElementName=NameMaxCurrentDownloads, Path=SelectedValue}" />
                        </EventTriggerBehavior>
                    </Interaction.Behaviors>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock FontSize="{DynamicResource DownKyiFontSizeBody}" Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource Split}" />
                <ComboBox
                    Name="NameSplits"
                    Width="180"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    VerticalContentAlignment="Center"
                    ItemsSource="{Binding Splits}"
                    SelectedValue="{Binding SelectedSplit}">
                    <Interaction.Behaviors>
                        <EventTriggerBehavior EventName="SelectionChanged">
                            <InvokeCommandAction Command="{Binding SplitsCommand}" CommandParameter="{Binding ElementName=NameSplits, Path=SelectedValue}" />
                        </EventTriggerBehavior>
                    </Interaction.Behaviors>
                </ComboBox>
            </StackPanel>
        </Grid>
        <TextBlock
            Margin="0,20,0,0"
            FontSize="{DynamicResource DownKyiFontSizeCaption}"
            Foreground="{DynamicResource SpaceMuted}"
            Text="{DynamicResource ZeroMeansUnlimited}" />
        <Grid Margin="0,8,0,0" ColumnDefinitions="*,24,*" ToolTip.Tip="{DynamicResource PressEnterToApplySettingTip}">
            <StackPanel Grid.Column="0">
                <TextBlock FontSize="{DynamicResource DownKyiFontSizeBody}" Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource MaxOverallDownloadLimit}" />
                <TextBlock
                    Margin="0,3,0,0"
                    FontSize="{DynamicResource DownKyiFontSizeCaption}"
                    Foreground="{DynamicResource SpaceMuted}"
                    Text="{DynamicResource MaxOverallDownloadLimitDescription}" />
                <TextBox
                    Name="NameMaxOverallDownloadLimit"
                    Width="180"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    VerticalContentAlignment="Center"
                    Text="{Binding MaxOverallDownloadLimit}">
                    <TextBox.KeyBindings>
                        <KeyBinding Command="{Binding MaxOverallDownloadLimitCommand}" CommandParameter="{Binding #NameMaxOverallDownloadLimit.Text}" Gesture="Enter" />
                    </TextBox.KeyBindings>
                </TextBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock FontSize="{DynamicResource DownKyiFontSizeBody}" Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource MaxDownloadLimit}" />
                <TextBlock
                    Margin="0,3,0,0"
                    FontSize="{DynamicResource DownKyiFontSizeCaption}"
                    Foreground="{DynamicResource SpaceMuted}"
                    Text="{DynamicResource MaxDownloadLimitDescription}" />
                <TextBox
                    Name="NameMaxDownloadLimit"
                    Width="180"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    VerticalContentAlignment="Center"
                    Text="{Binding MaxDownloadLimit}">
                    <TextBox.KeyBindings>
                        <KeyBinding Command="{Binding MaxDownloadLimitCommand}" CommandParameter="{Binding #NameMaxDownloadLimit.Text}" Gesture="Enter" />
                    </TextBox.KeyBindings>
                </TextBox>
            </StackPanel>
        </Grid>
        <CheckBox
            Name="NameIsHttpProxy"
            Margin="0,18,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Command="{Binding IsHttpProxyCommand}"
            Content="{DynamicResource IsHttpProxy}"
            FontSize="{DynamicResource DownKyiFontSizeBody}"
            Foreground="{DynamicResource SpaceInk}"
            IsChecked="{Binding IsHttpProxy, Mode=TwoWay}" />
        <Grid
            Name="NameHttpProxyPanel"
            IsVisible="{Binding IsHttpProxy}"
            Margin="28,12,0,0"
            ColumnDefinitions="*,24,*"
            ToolTip.Tip="{DynamicResource PressEnterToApplySettingTip}">
            <StackPanel Grid.Column="0">
                <TextBlock FontSize="{DynamicResource DownKyiFontSizeBody}" Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource HttpProxy}" />
                <TextBox
                    Name="NameHttpProxy"
                    Width="220"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    VerticalContentAlignment="Center"
                    Text="{Binding HttpProxy}">
                    <TextBox.KeyBindings>
                        <KeyBinding Command="{Binding HttpProxyCommand}" CommandParameter="{Binding #NameHttpProxy.Text}" Gesture="Enter" />
                    </TextBox.KeyBindings>
                </TextBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock FontSize="{DynamicResource DownKyiFontSizeBody}" Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource HttpProxyPort}" />
                <TextBox
                    Name="NameHttpProxyPort"
                    Width="140"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    VerticalContentAlignment="Center"
                    Text="{Binding HttpProxyPort}">
                    <TextBox.KeyBindings>
                        <KeyBinding Command="{Binding HttpProxyPortCommand}" CommandParameter="{Binding #NameHttpProxyPort.Text}" Gesture="Enter" />
                    </TextBox.KeyBindings>
                </TextBox>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
