<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DownKyi.ViewModels"
    x:Class="DownKyi.Views.VideoDetailActionsView"
    x:DataType="vm:ViewVideoDetailViewModel"
    mc:Ignorable="d"
    Classes="studio-page">
    <UserControl.Styles>
        <StyleInclude Source="/Themes/Styles/Studio.axaml" />
    </UserControl.Styles>
    <Border
        Padding="0,12,0,0"
        Background="{DynamicResource SpacePaper}"
        BorderBrush="{DynamicResource SpaceRule}"
        BorderThickness="0,1,0,0"
        CornerRadius="0">
        <Grid ColumnDefinitions="Auto,Auto,16,*,Auto">
            <CheckBox
                Grid.Column="0"
                VerticalAlignment="Center"
                Command="{Binding SelectAllCommand}"
                Content="{DynamicResource SelectAll}"
                Foreground="{DynamicResource SpaceInk}"
                IsChecked="{Binding UiState.IsSelectAll, Mode=TwoWay}" />
            <Button
                Grid.Column="1"
                MinWidth="88"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding ClearSelectionCommand}"
                Content="{DynamicResource ClearSelection}"
                FontSize="12"
                Name="DetailClearSelection" />
            <Grid
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                ColumnDefinitions="Auto,*"
                Margin="8,0,16,0">
                <Label
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Content="{DynamicResource Search}"
                    Foreground="{DynamicResource SpaceInk}" />
                <TextBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    PlaceholderText="{DynamicResource SearchVideoByName}"
                    Text="{Binding Path=UiState.InputSearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Name="DetailSearch">
                    <TextBox.KeyBindings>
                        <KeyBinding Command="{Binding InputSearchCommand}" Gesture="Enter" />
                    </TextBox.KeyBindings>
                </TextBox>
            </Grid>
            <Button
                Grid.Column="4"
                MinWidth="96"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding AddToDownloadCommand}"
                Content="{DynamicResource DownloadSelected}"
                FontSize="12"
                Name="DetailDownloadSelected"
                Classes="studio-primary" />
        </Grid>
    </Border>
</UserControl>
