<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vmp="clr-namespace:DownKyi.Presentation"
                    xmlns:vm="clr-namespace:DownKyi.ViewModels">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="DownloadWarning">#B63025</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="DownloadWarning">#FF8270</SolidColorBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <!-- The download workspace shares the personal-space palette with denser controls. -->
    <ControlTheme x:Key="DownloadSectionItem" TargetType="ListBoxItem" x:DataType="vmp:TabHeader">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource SpaceMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="20,12" Margin="4,0,0,0" BorderThickness="0,0,0,3"
                        Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Name="DownloadQueueCount" IsVisible="{Binding !Id}"
                                   FontFamily="Cascadia Mono,Consolas,monospace"
                                   Text="{Binding $parent[UserControl].((vm:ViewDownloadManagerViewModel)DataContext).DownloadLists.Downloading.Count}" />
                        <TextBlock Name="DownloadHistoryCount" IsVisible="{Binding Id}"
                                   FontFamily="Cascadia Mono,Consolas,monospace"
                                   Text="{Binding $parent[UserControl].((vm:ViewDownloadManagerViewModel)DataContext).DownloadLists.Downloaded.Count}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource SpaceHover}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource SpaceInk}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SpaceAccent}" />
        </Style>
        <Style Selector="^:focus-visible">
            <Setter Property="Background" Value="{DynamicResource SpaceHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SpaceInk}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="DownloadActionButton" TargetType="Button" BasedOn="{StaticResource PersonalActionButton}">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{DynamicResource SpacePaper}" />
        <Setter Property="Foreground" Value="{DynamicResource SpaceInk}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SpaceRule}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Style Selector="^.danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource SpacePaper}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DownloadWarning}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="DownloadProgress" TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource SpaceRule}" />
        <Setter Property="Foreground" Value="{DynamicResource SpaceAccent}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True">
                    <Border Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^.failed">
            <Setter Property="Foreground" Value="{DynamicResource DownloadWarning}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
